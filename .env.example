# Site Configuration
NEXT_PUBLIC_SITE_URL=

# Cloudflare R2 (public base URL for media)
NEXT_PUBLIC_R2_PUBLIC_URL=

# OpenAI API (for Lia AI)
OPENAI_API_KEY=

# Weather API
OPENWEATHER_API_KEY=

# ElevenLabs API
ELEVENLABS_API_KEY=

# Whop Payment
NEXT_PUBLIC_WHOP_COMPANY_ID=
NEXT_PUBLIC_WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=

# Meta Graph API (Facebook Page + Instagram auto-publish)
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=

# Meta webhook - RECEIVES Facebook Page messages and Instagram DMs
# META_VERIFY_TOKEN  : any random string; must match what you type in Meta
# META_APP_SECRET    : App Settings > Basic > App Secret
# META_PAGE_ACCESS_TOKEN : page token, used to look up a sender's real name
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# ---------------------------------------------------------------- Lia Desk ---
# The CRM every lead lands in. LIADESK_API_KEY belongs to the integration user
# site@renesadventures.tours, so revoking it disturbs nobody's real login.
# LIADESK_OWNER_ID is the salesperson who owns new leads.
LIADESK_URL=
LIADESK_DB=
LIADESK_USER=
LIADESK_API_KEY=
LIADESK_OWNER_ID=

# --------------------------------------------------------------------- Lia ---
# LIA_MODEL
#   Which model answers guests. Default gpt-4o-mini. Set gpt-4o to upgrade her
#   judgement at roughly fifteen times the cost per reply — still cents a day
#   at this volume, and worth it if a reply ever reads thin.
#
# LIA_SOCIAL_AUTOREPLY
#   "on" lets Lia answer Facebook and Instagram herself. ANY OTHER VALUE, OR
#   UNSET, MEANS DRAFT ONLY: she still reads every message and comment, still
#   creates the lead, still writes the reply onto it — and sends nothing.
#   Leave this off until App Review has granted the permissions AND Chris has
#   agreed to let her answer in his inboxes. It is the kill switch: unset it
#   and she goes quiet within one deploy.
#
# LIA_INTERNAL_KEY
#   Shared secret for POST /api/lia/draft-reply, which drafts a reply to an
#   email and never sends it. Unset means the route refuses every request.
LIA_MODEL=
LIA_SOCIAL_AUTOREPLY=
LIA_INTERNAL_KEY=
